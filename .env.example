# ==============================================================================
# EjjiLink AI — Environment Configuration (.env.example)
# ==============================================================================
# Important: Never commit actual secret keys or .env.local to Git.
# In Google AI Studio Build, GEMINI_API_KEY is automatically injected at runtime.
# Production secrets should be configured through your cloud hosting platform.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Server-Side AI Provider (Required)
# ------------------------------------------------------------------------------
# Secret API key used ONLY on the server (server.ts) for Gemini models:
# - gemini-3.5-transcribe (Speech-to-text audio transcription)
# - gemini-3.8-flash (AI communication assistant, translation, and document OCR)
# NEVER prefix with VITE_ or NEXT_PUBLIC_.
GEMINI_API_KEY="your-gemini-api-key-here"

# Optional alternative AI provider keys
AI_PROVIDER_API_KEY=""
TRANSLATION_API_KEY=""

# ------------------------------------------------------------------------------
# 2. Firebase Web Client Configuration (Public)
# ------------------------------------------------------------------------------
# Safe to include in client bundles. Loaded via firebase-applet-config.json
# or environment variables for web authentication and Firestore data sync.
VITE_FIREBASE_API_KEY="AIzaSyExampleKeyForPublicClientUse"
VITE_FIREBASE_AUTH_DOMAIN="gen-lang-client-0578092347.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="gen-lang-client-0578092347"
VITE_FIREBASE_STORAGE_BUCKET="gen-lang-client-0578092347.appspot.com"
VITE_FIREBASE_MESSAGING_SENDER_ID="701468368007"
VITE_FIREBASE_APP_ID="1:701468368007:web:c6ef5984f114c022877a16"
VITE_FIREBASE_DATABASE_ID="ai-studio-ejjilinkaiwhereh-1cbf0049-48ff-4541-9e3b-0aa5641ff17c"

# Next.js compatibility aliases (if migrating to Next.js App Router)
NEXT_PUBLIC_FIREBASE_API_KEY=""
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=""
NEXT_PUBLIC_FIREBASE_PROJECT_ID=""
NEXT_PUBLIC_FIREBASE_APP_ID=""

# ------------------------------------------------------------------------------
# 3. Server-Side Firebase Admin Credentials (Private Service Account)
# ------------------------------------------------------------------------------
# Strictly server-side; NEVER expose to client or prefix with NEXT_PUBLIC_/VITE_.
FIREBASE_CLIENT_EMAIL=""
FIREBASE_PRIVATE_KEY=""

# ------------------------------------------------------------------------------
# 4. Server & Runtime Environment
# ------------------------------------------------------------------------------
PORT=3000
NODE_ENV="development"
APP_URL="http://localhost:3000"
